2. Accept Transport RequestAllows a driver to claim and accept a transport job.Endpoint: PATCH /api/driver/accept/:requestIdHeaders: Authorization: <JWT_TOKEN> (Requires Driver role)Response (200 OK):JSON{
  "message": "Transport request accepted successfully",
  "transportRequest": {
    "_id": "6a9c4120d619e21dd54c9b5f",
    "productType": "Cassava Tubers",
    "quantity": 150,
    "pickupLocation": "Farm Block 4, Idiroko Road, Ota, Ogun State",
    "deliveryLocation": "Agro Processing Hub, Mile 12 Market, Lagos",
    "requestedBy": "66d93e10f3c1a892b42d1921",
    "acceptedBy": "6a9c26d79d3ac6a9ef517286",
    "isAccepted": true,
    "isInTransit": true,
    "isDelivered": false,
    "isDelete": false
  }
}
